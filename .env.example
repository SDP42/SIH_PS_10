# WHO ICD-11 API credentials — register free at https://icd.who.int/icdapi
#
# Without these the service runs in SNAPSHOT_ONLY mode: every WHO endpoint
# degrades to the local ICD-11 snapshot and labels itself as such. Nothing
# breaks; the WHO Sync page shows a banner explaining the mode.
ICD_API_CLIENT_ID=
ICD_API_CLIENT_SECRET=

# HMAC key for ABHA Demo Mode tokens (app/auth.py). Optional locally;
# set a real value in any deployed environment.
DEMO_AUTH_SECRET=
